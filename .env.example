# Cyber Recovery Orchestrator - example environment
# Copy to .env and adjust. Every value here is also the in-code default,
# so an empty .env (or none at all) runs the fully offline MOCK setup.

# --- application -----------------------------------------------------------
APP_NAME=Cyber Recovery Orchestrator
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# SQLite by default (file created automatically). For PostgreSQL use:
#   postgresql+psycopg://cro:cro@localhost:5432/cyber_recovery
DATABASE_URL=sqlite:///./data/cyber_recovery.db

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:8011,http://127.0.0.1:8011

# Set true ONLY in test/lab environments: exposes POST /api/v1/debug/faults
# used to arm a post-restore verification failure and exercise rollback.
ENABLE_FAULT_INJECTION=false

# --- LLM provider ----------------------------------------------------------
# mock    : deterministic local reasoning provider (no network, no key needed)
# openai  : any OpenAI-compatible /chat/completions endpoint
# The LLM produces reasoning summaries ONLY; every fact comes from registered
# audited tools. Recovery logic is deterministic either way.
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
